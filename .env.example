# Backend (read by api container — keep secrets only on server)

# Redis (sessions, OTP, rate limits — required for multi-replica API)
REDIS_PASSWORD=
# Optional override for local/non-compose runs. In Docker Compose REDIS_URL is built from REDIS_PASSWORD.
# REDIS_URL=redis://:your-password@redis:6379/0

# Токен для страницы /admin/redis и API /api/admin/redis-auth.
# ADMIN_REDIS_TOKEN=

# How many latest auth events to keep in Redis for the admin auth monitor.
AUTH_EVENT_LIMIT=10000

# Basic Auth для /admin/redis и /api/admin/* на nginx.
# ADMIN_BASIC_USER=admin
# ADMIN_BASIC_PASSWORD=

# Отправка OTP по email через AWS SES (SMTP).
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_PORT=465
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Отправитель (должен быть верифицирован в SES).
MAIL_FROM_NAME=220v
MAIL_FROM_EMAIL=support@220v.shop

# Белый список доменов email (через запятую, lowercase).
ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,aol.com,live.com,msn.com,me.com,mac.com,googlemail.com,ymail.com,mail.ru,yandex.ru,ya.ru,bk.ru,inbox.ru,list.ru,rambler.ru,internet.ru,protonmail.com,proton.me,pm.me,tutanota.com,zoho.com,comcast.net,verizon.net,gmx.com,happ.su,hop.su,vk.com

REMNAWAVE_URL=https://remna.2oo.uk
REMNAWAVE_TOKEN=
MAX_DEVICES=7

# RMW — сессия/пользователь после входа и оплата
RMW_API_URL=
RMW_API_KEY=

# Хосты, на которые разрешён редирект payment_url от RMW
# BILLING_ALLOWED_HOSTS=pay.example.com,checkout.example.com

# Текст важного объявления на /support
# NOTICE=

# Редиректы после оплаты (абсолютные https URL)
# BILLING_SUCCESS_URL=https://220v.shop/pay/success
# BILLING_CANCEL_URL=https://220v.shop/pay/fail
PUBLIC_SITE_URL=https://220v.shop

# Cookie Secure flag (auto true in NODE_ENV=production; set false for local http)
# COOKIE_SECURE=false

# Optional: API port inside container (default 3001)
# PORT=3001

# API log level: trace | debug | info | warn | error (default info in production)
# LOG_LEVEL=info

# Web port published on the host.
# HOST_WEB_BIND_IP=0.0.0.0
# HOST_WEB_PORT=9085

# Local Vite dev: optional override (default /api — proxied to localhost:3001)
# VITE_API_URL=/api

# Цены первого рендера на /tariff до загрузки billing/meta из RMW
VITE_TARIFF_PRICE_SUB_1M=450
VITE_TARIFF_PRICE_SUB_6M=2400
VITE_TARIFF_PRICE_SUB_12M=4000

TRAFFIC_LIMIT_SUBTRACT_GB=0

# Talk-Me REST API (для /chat — backend-proxy)
TALKME_API_TOKEN=

# Загрузки вложений в чат поддержки
SUPPORT_CHAT_UPLOADS_DIR=/app/uploads/support-chat
SUPPORT_CHAT_MAX_FILE_SIZE_MB=50
# SUPPORT_CHAT_UPLOADS_HOST_DIR=./data/support-chat-uploads

# CSP report URI (optional)
# CSP_REPORT_URI=
